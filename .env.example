# =============================================================================
# .env.example — copy this to .env and fill in your values
#
#   cp .env.example .env
#
# NEVER commit .env to git. It is listed in .gitignore.
# =============================================================================


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Credentials for the PostgreSQL container.
# These are used by both the postgres service and the app service.

POSTGRES_USER=retailuser
POSTGRES_PASSWORD=retailpass
POSTGRES_DB=retaildb


# ── Groq API ──────────────────────────────────────────────────────────────────
# Free API key — sign up at https://console.groq.com
# The app uses llama-3.3-70b-versatile by default (override with GROQ_MODEL).

GROQ_API_KEY=your_groq_api_key_here


# ── Optional overrides ────────────────────────────────────────────────────────
# These have sensible defaults; only set if you need to change them.

# POSTGRES_HOST=localhost           # Docker Compose overrides this to "postgres" automatically
# POSTGRES_PORT=5432                # Default: 5432
# MAX_ROWS=50                       # Max rows returned per query (default: 50)
# GROQ_MODEL=llama-3.3-70b-versatile  # Groq model ID (default: llama-3.3-70b-versatile)
