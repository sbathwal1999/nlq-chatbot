# =============================================================================
# .gitignore
# =============================================================================


# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.pem
*.key


# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]           # .pyc, .pyo, .pyd
*.so

# Virtual environments
.venv/
venv/
env/

# uv
.uv/
# uv.lock is intentionally NOT ignored — commit it for reproducible installs.
# If you don't want to commit it, uncomment the line below:
# uv.lock

# Distribution / packaging
dist/
build/
*.egg-info/


# ── Docker ────────────────────────────────────────────────────────────────────
*.log


# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store


# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
